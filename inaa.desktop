[Desktop Entry]
Type=Application
Name=INAA
Comment=Pemutar media untuk Linux terinspirasi IINA
Exec=inaa %F
Icon=io.github.inaa
Terminal=false
Categories=AudioVideo;Player;Audio;Video;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-flv;video/mpeg;audio/mpeg;audio/x-wav;audio/flac;audio/ogg;audio/mp4;application/ogg;
StartupWMClass=io.github.inaa
